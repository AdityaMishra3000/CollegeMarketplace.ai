# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────
# Required when NODE_ENV=production. Defaults to localhost otherwise.
MONGODB_URI=mongodb://127.0.0.1:27017/college_marketplace

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED. No default exists in any environment — the server refuses to start
# without it, and refuses any value shorter than 32 characters or previously
# committed to this repository.
#
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────
# Explicit allowlist of browser origins permitted to call this API. Never `*`.
# Required when NODE_ENV=production; defaults to localhost origins in dev.
#
# List the origin the site is *served from*, not the API's own address. Even when
# the SPA reaches /api same-origin through a proxy, browsers send `Origin` on
# POST/PUT/DELETE and the proxy forwards it, so the site's hostname must appear
# here. Add a scheme+host+port entry per deployment hostname; the port must match
# exactly (`http://marketplace.io` and `http://marketplace.io:5173` are distinct).
CORS_ORIGINS=http://marketplace.io,http://localhost,http://localhost:5173

# Number of proxy hops in front of the app (nginx = 1). Used so rate limiting
# sees real client IPs.
TRUST_PROXY_HOPS=1

# ── ML service ────────────────────────────────────────────────────────────
# Reachable on the internal network only; it needs no published host port.
ML_SERVICE_URL=http://localhost:5001
ML_TIMEOUT_MS=5000
ML_RECOMMEND_TIMEOUT_MS=8000

# How many candidate listings are scored per recommendation request, and how
# long a computed ranking is reused.
RECOMMEND_CANDIDATE_LIMIT=200
RECOMMEND_CACHE_TTL_MS=60000

# ── Image uploads (optional) ──────────────────────────────────────────────
# POST /api/upload returns 503 unless all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
