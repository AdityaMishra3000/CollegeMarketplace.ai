# Base URL the SPA uses for API calls.
#
# Leave it as /api for any deployment where the frontend and the API share an
# origin. The Vite dev server (see vite.config.js) and nginx.conf both proxy
# /api to the backend, so the app works under localhost, marketplace.io or any
# other hostname without touching CORS.
VITE_API_BASE_URL=/api

# Only set an absolute URL when the API really is on a different origin — and
# add that origin to the backend's CORS_ORIGINS allowlist as well:
# VITE_API_BASE_URL=http://localhost:5000/api

# Where the dev server proxies /api to. Defaults to http://localhost:5000.
# docker compose sets this to http://backend:5000.
# VITE_DEV_API_PROXY=http://backend:5000
