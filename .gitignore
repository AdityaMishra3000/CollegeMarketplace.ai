# ─────────────────────────────
# OS & editor files
# ─────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo

# ─────────────────────────────
# Secrets — never commit these
# ─────────────────────────────
.env
.env.*
!.env.example
*.pem
credentials.json

# ─────────────────────────────
# Node
# ─────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log
yarn-debug.log
dist/
build/
.next/
coverage/

# Lock files are intentionally NOT ignored: this is an application, so builds
# should be reproducible.

# ─────────────────────────────
# Python
# ─────────────────────────────
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
.pytest_cache/

# ─────────────────────────────
# Logs & local databases
# ─────────────────────────────
*.log
*.sqlite3
*.db
